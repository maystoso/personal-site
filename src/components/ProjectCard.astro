---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// project.image.src is the full-resolution original.
// The <Image> below is the small optimized thumbnail.
const fullSrc = project.image.src;
---
<button
  class="card framed"
  type="button"
  data-full={fullSrc}
  data-alt={project.title}
  data-title={project.title}
  aria-label={`View ${project.title} full size`}
>
  <div class="media">
    <Image
      src={project.image}
      alt={project.title}
      widths={[300, 600, 900]}
      sizes="(max-width: 700px) 60vw, 20vw"
      loading="lazy"
    />
  </div>
  <div class="meta">
    <p class="kind">{project.kind}</p>
    <h3>{project.title}</h3>
    <p class="desc">{project.description}</p>
  </div>
</button>

<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--bg-raised);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.25s ease;
  }

  .card:hover { transform: translateY(-4px); }
  .card:hover::before,
  .card:hover::after { border-color: var(--accent-rose); }

  .media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 0.9rem;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .kind {
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  h3 {
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .desc {
    font-size: 0.84rem;
    color: var(--ink-dim);
  }
</style>
