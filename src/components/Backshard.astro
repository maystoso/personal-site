---
// Small dark sliver at the bottom of interior pages, back to the mirror.
// Sits on a pool of blackness so it reads as a hole rather than a button.
---
<a class="back-shard" href="/" aria-label="Back to the mirror">
  <span class="pop">back</span>
  <svg viewBox="0 0 120 46" aria-hidden="true">
    <polygon id="back-shard-poly" points="8,30 34,6 62,22 88,4 112,28 96,42 58,32 26,44" />
  </svg>
</a>

<style>
  .back-shard {
    position: fixed;
    /* Clears Astro's dev toolbar, which sits at the bottom centre while
       the dev server is running. It doesn't exist on the built site. */
    bottom: 6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    width: 132px;
    display: grid;
    place-items: center;
    text-decoration: none;
  }

  /* The black backlight — a pool of dark that deepens on hover. */
  .back-shard::before {
    content: '';
    position: absolute;
    width: 230%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.75) 38%,
      rgba(0, 0, 0, 0) 72%
    );
    opacity: 0.85;
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .back-shard:hover::before,
  .back-shard:focus-visible::before {
    opacity: 1;
    transform: scale(1.15);
  }

  .back-shard svg {
    position: relative;
    width: 100%;
    height: auto;
    fill: #08070e;
    stroke: rgba(155, 135, 217, 0.32);
    stroke-width: 1.2;
    transition: stroke 0.3s ease, fill 0.3s ease;
  }

  .back-shard:hover svg,
  .back-shard:focus-visible svg {
    fill: #100d1c;
    stroke: var(--accent-rose);
  }

  /* Hidden until hovered, then rises above the shard. */
  .pop {
    position: absolute;
    bottom: 100%;
    margin-bottom: 0.45rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    color: var(--ink);
    text-shadow: 0 0 12px rgba(6, 5, 10, 0.95);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .back-shard:hover .pop,
  .back-shard:focus-visible .pop {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 560px) {
    .back-shard { width: 104px; bottom: 5rem; }
  }

  /* No hover on touch — show the word so it isn't a mystery. */
  @media (hover: none) {
    .pop { opacity: 1; transform: none; }
  }
</style>

<script>
  const poly = document.getElementById('back-shard-poly');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (poly && !reduced) {
    const N = 9;              // vertex count, fixed so shapes can interpolate
    const CX = 60, CY = 23;   // centre of the 120x46 viewBox
    const RX = 54, RY = 20;

    // A jagged ring: each vertex sits at its own angle but a random
    // distance out, which is what makes it read as a broken sliver.
    function target() {
      return Array.from({ length: N }, (_, i) => {
        const a = (i / N) * Math.PI * 2;
        const jag = 0.42 + Math.random() * 0.58;
        return [CX + Math.cos(a) * RX * jag, CY + Math.sin(a) * RY * jag];
      });
    }

    let current = target();
    let goal = target();
    // Per-vertex speed so the shape shifts unevenly rather than as a unit.
    let rates = Array.from({ length: N }, () => 0.03 + Math.random() * 0.05);

    function step() {
      let settled = true;

      for (let i = 0; i < N; i++) {
        for (let k = 0; k < 2; k++) {
          const diff = goal[i][k] - current[i][k];
          if (Math.abs(diff) > 0.15) settled = false;
          current[i][k] += diff * rates[i];
        }
      }

      poly.setAttribute(
        'points',
        current.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ')
      );

      // Once it arrives, pick somewhere new to go.
      if (settled) {
        goal = target();
        rates = rates.map(() => 0.03 + Math.random() * 0.05);
      }

      requestAnimationFrame(step);
    }

    step();
  }
</script>