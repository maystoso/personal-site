---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found — Myka Escaran" hideHeader>
  <div class="wrap masthead">
    <p class="eyebrow">404</p>
    <h1>Nothing here</h1>
    <p class="lede">That page doesn't exist. Try the work or the resume.</p>
    <div class="actions">
      <a class="btn" href="/">Home</a>
      <a class="btn" href="/resume">Resume</a>
    </div>
  </div>
</Layout>

<style>
  .actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem; }
</style>